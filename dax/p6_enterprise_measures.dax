/*
========================================================================================
Enterprise Primavera P6 Earned Value Management (EVM) & CPM Measure Library
Compliant with PMI Practice Standard for EVM and ISO 21508.
Direct Drop-in for Microsoft Power BI Desktop (.pbix)
========================================================================================
*/

// 1. Core Earned Value Metrics
Planned Value (PV) = 
SUM('P6_Activities'[Planned Duration (Days)])

Earned Value (EV) = 
SUMX(
    'P6_Activities', 
    'P6_Activities'[Planned Duration (Days)] * DIVIDE('P6_Activities'[Physical % Complete], 100, 0)
)

Actual Duration (AD) = 
SUM('P6_Activities'[Planned Duration (Days)]) - SUM('P6_Activities'[Remaining Duration (Days)])

// 2. Schedule Variances & Indices
Schedule Variance (SV) = 
[Earned Value (EV)] - [Planned Value (PV)]

Schedule Performance Index (SPI) = 
DIVIDE([Earned Value (EV)], [Planned Value (PV)], 1.0)

// 3. Dynamic Health Status Indicator (Green / Amber / Red)
Schedule Health Status = 
SWITCH(
    TRUE(),
    [Schedule Performance Index (SPI)] >= 1.0, "🟢 ON TRACK",
    [Schedule Performance Index (SPI)] >= 0.85, "🟡 MODERATE SLIPPAGE",
    "🔴 CRITICAL DELAY"
)

// 4. Critical Path Analysis Measures
Total Critical Tasks = 
CALCULATE(
    COUNTROWS('P6_Activities'),
    'P6_Activities'[Criticality] = "Critical"
)

Critical Path Ratio (%) = 
DIVIDE([Total Critical Tasks], COUNTROWS('P6_Activities'), 0) * 100

Dangling Tasks Count = 
CALCULATE(
    COUNTROWS('P6_Activities'),
    'P6_Activities'[Total Float (Days)] > 100
)

// 5. Forecast & Completion Velocity
Estimated Duration at Completion (EAC_t) = 
DIVIDE([Planned Value (PV)], [Schedule Performance Index (SPI)], [Planned Value (PV)])
